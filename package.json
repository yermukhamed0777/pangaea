{
  "name": "pangaea",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:root": "cross-env PANGAEA_BASE_PATH=/ next build",
    "build:subpath": "cross-env PANGAEA_BASE_PATH=/pangaea next build",
    "check:build-variants": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-build-variants.ts",
    "check:offline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-offline.ts",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/e2e.ts",
    "check:events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-events.ts",
    "walkthrough": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/walkthrough.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test",
    "bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/bench.ts",
    "bench:memory": "node --expose-gc --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/bench-memory.ts",
    "eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/eval.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run eval && npm run check:events && npm run bench && npm run build && npm run check:offline && npm run check:build-variants && npm run test:e2e && npm run walkthrough"
  },
  "dependencies": {
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.460.0",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0"
  }
}
